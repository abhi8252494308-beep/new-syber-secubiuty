# Database Configuration (SQLite for local development, PostgreSQL for Docker)
DATABASE_URL=sqlite+aiosqlite:///./securesite_audit.db
# DATABASE_URL=postgresql://securesite:securesite_password@db:5432/securesite_audit

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend Configuration
BACKEND_CORS_ORIGINS=http://localhost:3000,http://frontend:3000
API_V1_PREFIX=/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Redis (for caching and task queue)
REDIS_URL=redis://redis:6379/0

# Email Configuration (for verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@securesite-audit.com

# Application Settings
APP_NAME=SecureSite Audit
APP_URL=http://localhost:3000
DEBUG=True

# Audit Settings
AUDIT_TIMEOUT_SECONDS=120
MAX_CONCURRENT_AUDITS=5